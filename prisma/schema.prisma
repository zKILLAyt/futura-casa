generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IncomeKind {
  GROSS_SALARY
  NET_SALARY
  BENEFIT
  EXTRA
  OTHER
}

enum TransactionFrequency {
  MONTHLY
  WEEKLY
  YEARLY
  ONCE
}

enum ExpenseStatus {
  PENDING
  PAID
}

enum ExpenseNature {
  FIXED
  VARIABLE
}

enum ItemStatus {
  PLANNED
  IN_PROGRESS
  PURCHASED
  RECEIVED
}

enum ItemPriority {
  ESSENTIAL
  IMPORTANT
  OPTIONAL
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Household {
  id          String           @id @default(cuid())
  name        String
  createdAt   DateTime         @default(now())
  members     HouseholdMember[]
  categories  Category[]
  incomes     Income[]
  expenses    Expense[]
  properties  Property[]
  shopping    ShoppingItem[]
  goals       FinancialGoal[]
  activities  ActivityLog[]
  recurring   RecurringTransaction[]
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  memberships     HouseholdMember[]
  incomes         Income[]         @relation("IncomeResponsible")
  expenses        Expense[]        @relation("ExpenseResponsible")
  shopping        ShoppingItem[]   @relation("ShoppingResponsible")
  contributions   GoalContribution[]
  activities      ActivityLog[]    @relation("ActivityActor")
}

model HouseholdMember {
  householdId String
  userId      String
  role        String    @default("ADMIN")
  joinedAt    DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
  @@index([userId])
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  name        String
  type        CategoryType
  color       String       @default("#78917f")
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  incomes     Income[]
  expenses    Expense[]

  @@unique([householdId, name, type])
  @@index([householdId, type])
}

model Income {
  id             String               @id @default(cuid())
  householdId    String
  categoryId     String
  responsibleId  String?
  description    String
  amount         Decimal              @db.Decimal(12, 2)
  kind           IncomeKind
  frequency      TransactionFrequency @default(MONTHLY)
  occurredAt     DateTime             @default(now())
  notes          String?
  idempotencyKey String?
  requestHash    String?
  seedKey        String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  household      Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category       Category             @relation(fields: [categoryId], references: [id])
  responsible    User?                @relation("IncomeResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  recurring      RecurringTransaction?

  @@index([householdId, occurredAt])
  @@index([householdId, categoryId])
  @@unique([householdId, idempotencyKey])
}

model Expense {
  id             String               @id @default(cuid())
  householdId    String
  categoryId     String
  responsibleId  String?
  description    String
  amount         Decimal              @db.Decimal(12, 2)
  frequency      TransactionFrequency @default(MONTHLY)
  nature         ExpenseNature        @default(FIXED)
  dueAt          DateTime             @default(now())
  status         ExpenseStatus        @default(PENDING)
  isShared       Boolean              @default(true)
  notes          String?
  idempotencyKey String?
  requestHash    String?
  seedKey        String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  household      Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category       Category             @relation(fields: [categoryId], references: [id])
  responsible    User?                @relation("ExpenseResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  recurring      RecurringTransaction?

  @@index([householdId, dueAt, status])
  @@index([householdId, categoryId])
  @@unique([householdId, idempotencyKey])
}

model Property {
  id             String     @id @default(cuid())
  householdId    String
  title          String
  location       String
  rent           Decimal    @db.Decimal(12, 2)
  iptu           Decimal    @db.Decimal(12, 2)
  fireInsurance  Decimal    @db.Decimal(12, 2)
  trashFee       Decimal    @db.Decimal(12, 2)
  condoFee       Decimal    @db.Decimal(12, 2)
  areaM2         Decimal    @db.Decimal(7, 2)
  bedrooms       Int
  bathrooms      Int
  parkingSpaces  Int
  listingUrl     String
  status         String     @default("EM_ANALISE")
  createdAt      DateTime   @default(now())
  household      Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, status])
}

model ShoppingItem {
  id             String       @id @default(cuid())
  householdId    String
  responsibleId  String?
  name           String
  quantity       Int          @default(1)
  estimatedCost  Decimal?     @db.Decimal(12, 2)
  paidCost       Decimal?     @db.Decimal(12, 2)
  priority       ItemPriority @default(IMPORTANT)
  status         ItemStatus   @default(PLANNED)
  notes          String?
  createdAt      DateTime     @default(now())
  household      Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  responsible    User?        @relation("ShoppingResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([householdId, status, priority])
}

model FinancialGoal {
  id             String             @id @default(cuid())
  householdId    String
  name           String
  targetAmount   Decimal?           @db.Decimal(12, 2)
  targetDate     DateTime?
  createdAt      DateTime           @default(now())
  household      Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  contributions  GoalContribution[]

  @@index([householdId])
}

model GoalContribution {
  id          String       @id @default(cuid())
  goalId      String
  userId      String
  amount      Decimal      @db.Decimal(12, 2)
  contributedAt DateTime   @default(now())
  note        String?
  goal        FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, contributedAt])
  @@index([userId])
}

model RecurringTransaction {
  id          String               @id @default(cuid())
  householdId String
  incomeId    String?              @unique
  expenseId   String?              @unique
  frequency   TransactionFrequency @default(MONTHLY)
  nextDate    DateTime?
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  household   Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  income      Income?              @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  expense     Expense?             @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([householdId, active, nextDate])
}

model ActivityLog {
  id          String    @id @default(cuid())
  householdId String
  actorId     String?
  action      String
  entity      String
  entityId    String?
  description String
  amount      Decimal?  @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor       User?     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
}
